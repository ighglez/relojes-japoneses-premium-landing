# ==========================================
# TURSO DATABASE CONFIGURATION
# ==========================================
TURSO_CONNECTION_URL=your_turso_connection_url
TURSO_AUTH_TOKEN=your_turso_auth_token

# ==========================================
# BETTER AUTH CONFIGURATION
# ==========================================
# Secret para firmar tokens (mínimo 32 caracteres)
# Genera uno seguro con: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_min_32_chars
NEXTAUTH_SECRET=your_nextauth_secret

# URL base de tu aplicación
# Desarrollo: http://localhost:3000
# Producción: https://iwatchworks.com
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# GOOGLE OAUTH CONFIGURATION
# ==========================================
# Para obtener estas credenciales:
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un nuevo proyecto o selecciona uno existente
# 3. Habilita "Google+ API"
# 4. Ve a "Credenciales" y crea "ID de cliente OAuth 2.0"
# 5. Tipo de aplicación: "Aplicación web"
# 6. URIs de redireccionamiento autorizados:
#    - http://localhost:3000/api/auth/callback/google (desarrollo)
#    - https://iwatchworks.com/api/auth/callback/google (producción)
#
# IMPORTANTE: Actualiza los URIs de redireccionamiento en Google Console
# cuando despliegues a producción con tu dominio personalizado
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# RESEND EMAIL CONFIGURATION
# ==========================================
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=IWatchWorks <onboarding@resend.dev>

# ==========================================
# PRODUCTION DEPLOYMENT NOTES
# ==========================================
# Cuando despliegues en Vercel con tu dominio personalizado:
# 1. Actualiza NEXT_PUBLIC_SITE_URL con tu dominio (ej: https://iwatchworks.com)
# 2. Actualiza NEXTAUTH_URL con el mismo dominio
# 3. Agrega el nuevo URI de redireccionamiento en Google Console:
#    https://iwatchworks.com/api/auth/callback/google
# 4. Asegúrate de que todas las variables estén configuradas en Vercel
# 5. El sistema funcionará automáticamente con tu dominio